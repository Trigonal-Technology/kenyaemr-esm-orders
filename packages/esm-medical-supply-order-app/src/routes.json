{
  "$schema": "https://json.openmrs.org/routes.schema.json",
  "backendDependencies": {
    "fhir2": ">=1.2",
    "webservices.rest": ">=2.24.0"
  },
  "extensions": [
    {
      "name": "medical-supply-order-panel",
      "component": "medicalSupplyOrderPanel",
      "slot": "order-basket-slot",
      "order": 5
    },
    {
      "name": "patient-medical-supply-summary-dashboard",
      "component": "medicalsupplyDashboardLink",
      "slot": "patient-chart-dashboard-slot",
      "meta": {
        "slot": "patient-chart-medical-supply-dashboard-slot",
        "path": "medicalSupply",
        "hideDashboardTitle": true
      },
      "order": 4
    },
    {
      "name": "patient-medical-supply-dashboard",
      "component": "medicalSupplyOrdersSummary",
      "slot": "patient-chart-medical-supply-dashboard-slot",
      "meta": {
        "fullWidth": false
      }
    }
  ],
  "workspaces": [
    {
      "name": "add-medical-supply-order",
      "type": "order",
      "component": "addMedicalSupplyOrderWorkspace",
      "title": "Add medical supply order"
    }
  ],
  "workspaces2": [
    {
      "name": "add-medical-supply-order",
      "component": "addMedicalSupplyOrderWorkspace",
      "window": "patient-chart-order-basket"
    }
  ],
  "modals": [
    {
      "name": "reject-medical-supply-order-modal",
      "component": "rejectMedicalSupplyOrderModal"
    }
  ],
  "pages": [
    {
      "component": "root",
      "route": "medicalsupply"
    }
  ]
}